#!/bin/sh
# Runs inside cage (prism-kiosk.service): scales the screen, then starts Prism.
#
# PRISM_KIOSK_SCALE (from /etc/default/prism-kiosk) sets the output scale. Unset, a dense
# screen (170 dpi and more, like a 10" panel at 1920x1200) gets 2, anything else 1. Prism
# needs at least 900x600 points.
set -u

output="$(wlr-randr 2>/dev/null | awk 'NR == 1 { print $1 }')"
scale="${PRISM_KIOSK_SCALE:-}"
if [ -z "$scale" ] && [ -n "$output" ]; then
  scale="$(wlr-randr 2>/dev/null | awk '
    /current/ && !px { split($1, wh, "x"); px = wh[1] }
    /Physical size:/ { split($3, mm, "x"); w = mm[1] }
    END {
      if (px > 0 && w > 0 && px / (w / 25.4) >= 170) print 2; else print 1
    }')"
fi
if [ -n "$output" ] && [ -n "$scale" ]; then
  wlr-randr --output "$output" --scale "$scale" || true
fi

exec /usr/bin/prism
