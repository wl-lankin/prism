{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mini",
  "description": "The mini player: events and the app commands it calls (play, favorites, Flow, play modes, YouTube Music state). It cannot close, move or resize itself from script; the backend shows, hides and places it.",
  "webviews": ["mini"],
  "permissions": [
    "core:default",
    "allow-player-toggle",
    "allow-player-next",
    "allow-player-prev",
    "allow-player-set-volume",
    "allow-player-state",
    "allow-transport-active",
    "allow-flow-start",
    "allow-library-genres",
    "allow-favorites-ids",
    "allow-favorites-set",
    "allow-radio-saved",
    "allow-radio-favorite",
    "allow-radio-now-playing",
    "allow-navidrome-status",
    "allow-settings-get",
    "allow-settings-set",
    "allow-mini-layout",
    "allow-mini-menu",
    "allow-main-show",
    "allow-ytm-state"
  ]
}
