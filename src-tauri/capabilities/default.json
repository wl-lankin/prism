{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: its own title bar (minimize, maximize, close, drag, resize), the folder picker, the About links and the app commands its page calls.",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-is-maximized",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://wolfgang-linz.de/*" }, { "url": "https://github.com/wl-lankin/prism*" }]
    },
    "allow-player-play",
    "allow-player-toggle",
    "allow-player-next",
    "allow-player-prev",
    "allow-player-seek",
    "allow-player-set-volume",
    "allow-player-state",
    "allow-transport-active",
    "allow-player-play-files",
    "allow-player-append",
    "allow-player-jump",
    "allow-player-move",
    "allow-player-remove",
    "allow-player-queue-range",
    "allow-library-add-folder",
    "allow-library-remove-folder",
    "allow-library-folders",
    "allow-library-rescan",
    "allow-library-albums",
    "allow-library-album-tracks",
    "allow-library-artists",
    "allow-library-artist-albums",
    "allow-library-track-count",
    "allow-library-tracks-range",
    "allow-library-search",
    "allow-library-genres",
    "allow-flow-start",
    "allow-favorites-set",
    "allow-favorites-ids",
    "allow-favorites-tracks",
    "allow-favorites-albums",
    "allow-favorites-artists",
    "allow-playlists-list",
    "allow-playlist-create",
    "allow-playlist-rename",
    "allow-playlist-delete",
    "allow-playlist-entries",
    "allow-playlist-add",
    "allow-playlist-remove",
    "allow-playlist-move",
    "allow-settings-get",
    "allow-settings-set",
    "allow-audio-devices",
    "allow-navidrome-status",
    "allow-navidrome-test",
    "allow-navidrome-connect",
    "allow-navidrome-disconnect",
    "allow-navidrome-sync",
    "allow-navidrome-playlists",
    "allow-navidrome-playlist-entries",
    "allow-radio-place",
    "allow-radio-near",
    "allow-radio-search",
    "allow-radio-countries",
    "allow-radio-regions",
    "allow-radio-tags",
    "allow-radio-saved",
    "allow-radio-play",
    "allow-radio-favorite",
    "allow-radio-now-playing",
    "allow-radio-open-homepage",
    "allow-radio-redetect",
    "allow-tray-set-labels",
    "allow-window-vibrancy",
    "allow-startup-notice",
    "allow-ytm-show",
    "allow-ytm-hide",
    "allow-ytm-control",
    "allow-ytm-state",
    "allow-ytm-sign-in",
    "allow-ytm-sign-out"
  ]
}
