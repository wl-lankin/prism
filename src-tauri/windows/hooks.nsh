; Adds Prism to Explorer's "Open with" list for audio files. Nothing here writes an
; extension's own value, so Prism never becomes the default player on its own.

!macro NSIS_HOOK_POSTINSTALL
  WriteRegStr HKCU "Software\Classes\Prism.Audio" "" "Prism audio file"
  WriteRegStr HKCU "Software\Classes\Prism.Audio\DefaultIcon" "" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  WriteRegStr HKCU "Software\Classes\Prism.Audio\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe" "FriendlyAppName" "Prism"
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\shell\open\command" "" '"$INSTDIR\${MAINBINARYNAME}.exe" "%1"'
  WriteRegStr HKCU "Software\Classes\.mp3\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".mp3" ""
  WriteRegStr HKCU "Software\Classes\.m4a\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".m4a" ""
  WriteRegStr HKCU "Software\Classes\.m4b\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".m4b" ""
  WriteRegStr HKCU "Software\Classes\.aac\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".aac" ""
  WriteRegStr HKCU "Software\Classes\.alac\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".alac" ""
  WriteRegStr HKCU "Software\Classes\.flac\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".flac" ""
  WriteRegStr HKCU "Software\Classes\.wav\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".wav" ""
  WriteRegStr HKCU "Software\Classes\.aif\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".aif" ""
  WriteRegStr HKCU "Software\Classes\.aiff\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".aiff" ""
  WriteRegStr HKCU "Software\Classes\.aifc\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".aifc" ""
  WriteRegStr HKCU "Software\Classes\.ogg\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".ogg" ""
  WriteRegStr HKCU "Software\Classes\.oga\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".oga" ""
  WriteRegStr HKCU "Software\Classes\.opus\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".opus" ""
  WriteRegStr HKCU "Software\Classes\.wma\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".wma" ""
  WriteRegStr HKCU "Software\Classes\.ape\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".ape" ""
  WriteRegStr HKCU "Software\Classes\.wv\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".wv" ""
  WriteRegStr HKCU "Software\Classes\.mpc\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".mpc" ""
  WriteRegStr HKCU "Software\Classes\.tta\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".tta" ""
  WriteRegStr HKCU "Software\Classes\.dsf\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".dsf" ""
  WriteRegStr HKCU "Software\Classes\.dff\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".dff" ""
  WriteRegStr HKCU "Software\Classes\.mka\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".mka" ""
  WriteRegStr HKCU "Software\Classes\.webm\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".webm" ""
  WriteRegStr HKCU "Software\Classes\.caf\OpenWithProgids" "Prism.Audio" ""
  WriteRegStr HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe\SupportedTypes" ".caf" ""
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

!macro NSIS_HOOK_PREUNINSTALL
  DeleteRegValue HKCU "Software\Classes\.mp3\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.m4a\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.m4b\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.aac\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.alac\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.flac\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.wav\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.aif\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.aiff\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.aifc\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.ogg\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.oga\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.opus\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.wma\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.ape\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.wv\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.mpc\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.tta\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.dsf\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.dff\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.mka\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.webm\OpenWithProgids" "Prism.Audio"
  DeleteRegValue HKCU "Software\Classes\.caf\OpenWithProgids" "Prism.Audio"
  DeleteRegKey HKCU "Software\Classes\Prism.Audio"
  DeleteRegKey HKCU "Software\Classes\Applications\${MAINBINARYNAME}.exe"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
